   "source": [
    "OUTPUT_FOLDER = \"org_reports\"   # where downloaded plans/reports get saved\n",
    "\n",
    "# Tier 3 uses these to decide which homepage links are worth clicking into.\n",
    "# A \"Publications\" or \"About\" page is where reports usually hide.\n",
    "ABOUT_WORDS = [\"about\", \"publication\", \"news\", \"resource\", \"who-we-are\", \"media\", \"report\"]\n",
    "\n",
    "# Tier 1 uses these to pre-filter links before spending a Gemini call.\n",
    "# Cheap string matching first, expensive AI call second.\n",
    "KEYWORDS = [\"strategic\", \"impact\", \"annual\", \"report\", \"plan\"]"
   ]
  },
  {
   "cell_type": "code",
