   "source": [
    "os.makedirs(OUTPUT_FOLDER, exist_ok=True)\n",
    " \n",
    "df = pd.read_csv(\"../../GWIorgs_v4.csv\")\n",
    "df = df.fillna(\"\")\n",
    " \n",
    "index_rows = []\n",
    " \n",
    "for i in range(len(df)):\n",
    "    name = df.loc[i, \"Name\"]\n",
    "    url = df.loc[i, \"URL\"]\n",
    "    org_folder = os.path.join(OUTPUT_FOLDER, safe_name(name))\n",
    " \n",
    "    print(f\"[{i+1}/{len(df)}] {name}\")\n",
    " \n",
    "    all_links = get_all_links(url)\n",
    "    method_used = \"\"\n",
    "    plan_url, impact_url = None, None\n",
    " \n",
    "    # TIER 1: keyword-matched links\n",
    "    keyworded = keyword_filter(all_links)\n",
    "    if keyworded:\n",
    "        try:\n",
    "            plan_url, impact_url = ask_gemini_pick(name, keyworded)\n",
    "            method_used = \"tier1_keyword\"\n",
    "        except Exception as e:\n",
    "            print(f\"    tier1 Gemini failed: {e}\")\n",
    " \n",
    "    # TIER 2: if tier 1 found nothing, let Gemini pick from ALL links\n",
    "    if not plan_url and not impact_url and all_links:\n",
    "        try:\n",
    "            plan_url, impact_url = ask_gemini_pick(name, all_links)\n",
    "            if plan_url or impact_url:\n",
    "                method_used = \"tier2_all_links\"\n",
    "        except Exception as e:\n",
    "            print(f\"    tier2 Gemini failed: {e}\")\n",
    "            \n",
    "    # TIER 3: if still nothing, dig one level deeper (About/Publications pages)\n",
    "    if not plan_url and not impact_url:\n",
    "        deeper = get_deeper_links(url)\n",
    "        if deeper:\n",
    "            try:\n",
    "                plan_url, impact_url = ask_gemini_pick(name, deeper)\n",
    "                if plan_url or impact_url:\n",
    "                    method_used = \"tier3_deeper\"\n",
    "            except Exception as e:\n",
    "                print(f\"    tier3 Gemini failed: {e}\")\n",
    " \n",
    "    # download whatever was found\n",
    "    saved_plan, saved_impact = \"\", \"\"\n",
    "    if plan_url or impact_url:\n",
    "        os.makedirs(org_folder, exist_ok=True)\n",
    "    if plan_url:\n",
    "        saved_plan = download_and_save(plan_url, os.path.join(org_folder, \"strategic_plan\"))\n",
    "    if impact_url:\n",
    "        saved_impact = download_and_save(impact_url, os.path.join(org_folder, \"impact_report\"))\n",
    " \n",
    "    index_rows.append({\n",
    "        \"Name\": name,\n",
    "        \"Method\": method_used or \"none_found\",\n",
    "        \"Strategic_Plan_URL\": plan_url or \"\",\n",
    "        \"Strategic_Plan_File\": saved_plan,\n",
    "        \"Impact_Report_URL\": impact_url or \"\",\n",
    "        \"Impact_Report_File\": saved_impact,\n",
    "    })\n",
    " \n",
    "    time.sleep(2)\n",
    " \n",
    "index_df = pd.DataFrame(index_rows)\n",
    "index_df.to_csv(\"org_reports_index.csv\", index=False)\n",
    " \n",
    "n_plan = (index_df[\"Strategic_Plan_File\"] != \"\").sum()\n",
    "n_impact = (index_df[\"Impact_Report_File\"] != \"\").sum()\n",
    "n_tier2 = (index_df[\"Method\"] == \"tier2_all_links\").sum()\n",
    "n_tier3 = (index_df[\"Method\"] == \"tier3_deeper\").sum()\n",
    "\n",
    "print(f\"\\nDone. Plans: {n_plan}/{len(df)}, Reports: {n_impact}/{len(df)}.\")\n",
    "print(f\"({n_tier2} orgs needed the Tier 2 fallback.)\")\n",
    "print(f\"({n_tier2} orgs used Tier 2, {n_tier3} used Tier 3.)\")\n",
    "print(f\"Files in '{OUTPUT_FOLDER}/', index in org_reports_index.csv\")"
   ]
  },
