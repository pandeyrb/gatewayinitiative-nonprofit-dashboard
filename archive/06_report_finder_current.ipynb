    "### Combine the two columns from org_reports_index - final.csv onto GWIorgs_v4.csv"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "de834c3a",
   "metadata": {},
   "outputs": [],
   "source": [
    "gwi = pd.read_csv('../../GWIorgs_v4.csv', dtype=str)\n",
    "ori = pd.read_csv('org_reports_index - final.csv', dtype=str)\n",
    "\n",
    "# grab only the join key + the two columns we want\n",
    "cols = ori[['Name', 'Strategic_Plan_URL', 'Impact_Report_URL']]\n",
    "\n",
    "# left merge keeps all 65 GWI rows; orgs with no plan/report get NaN (blank)\n",
    "merged = gwi.merge(cols, on='Name', how='left')\n",
    "\n",
    "# optional: friendlier headers\n",
    "merged = merged.rename(columns={\n",
    "    'Strategic_Plan_URL': 'Strategic Plan',\n",
    "    'Impact_Report_URL': 'Impact Report',\n",
    "})\n",
    "\n",
    "merged.to_csv('GWIorgs_v5.csv', index=False)"
   ]
