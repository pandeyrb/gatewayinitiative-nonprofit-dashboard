   "id": "5f958eda",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask_gemini_pick(org_name, links):\n",
    "    if not links:\n",
    "        return None, None\n",
    " \n",
    "    listing = \"\\n\".join(f\"{i+1}. {L['label']} -> {L['url']}\" for i, L in enumerate(links[:40]))\n",
    " \n",
    "    prompt = f\"\"\"Here are links from {org_name}'s website:\n",
    " \n",
    "{listing}\n",
    " \n",
    "Based on the labels and URLs, which numbered link (if any) is most likely their\n",
    "STRATEGIC PLAN (their goals/plans for the future), and which is most likely their\n",
    "IMPACT REPORT or ANNUAL REPORT (past-year results/accomplishments)?\n",
    " \n",
    "Reply in EXACTLY this format, using \"none\" if there is no good match:\n",
    "STRATEGIC_PLAN: [number or \"none\"]\n",
    "IMPACT_REPORT: [number or \"none\"]\"\"\"\n",
    " \n",
    "    response = client.models.generate_content(model=\"gemini-2.5-flash\", contents=prompt)\n",
    "    text = response.text\n",
    " \n",
    "    plan_num, impact_num = None, None\n",
    "    for line in text.split(\"\\n\"):\n",
    "        line = line.strip()\n",
    "        if line.upper().startswith(\"STRATEGIC_PLAN:\"):\n",
    "            v = line.split(\":\", 1)[1].strip()\n",
    "            if v.isdigit():\n",
    "                plan_num = int(v)\n",
    "        elif line.upper().startswith(\"IMPACT_REPORT:\"):\n",
    "            v = line.split(\":\", 1)[1].strip()\n",
    "            if v.isdigit():\n",
    "                impact_num = int(v)\n",
    " \n",
    "    plan_url = links[plan_num - 1][\"url\"] if plan_num and plan_num <= len(links) else None\n",
    "    impact_url = links[impact_num - 1][\"url\"] if impact_num and impact_num <= len(links) else None\n",
    "    return plan_url, impact_url"
   ]
  },
