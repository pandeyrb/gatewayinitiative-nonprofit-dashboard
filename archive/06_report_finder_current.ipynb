    "def safe_name(name):\n",
    "    return re.sub(r\"[^a-zA-Z0-9]+\", \"_\", name).strip(\"_\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3c1bb54c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_all_links(url):\n",
    "    \"\"\"Fetch a page and return every link on it as {'url': ..., 'label': ...}.\n",
    "\n",
    "    Keeps same-domain links (the org's own pages) plus any PDF anywhere,\n",
    "    since reports are often PDFs hosted on a different domain.\n",
    "    \"\"\"\n",
    "    # Guard against blank or malformed URLs in the CSV\n",
    "    if not url.startswith(\"http\"):\n",
    "        return []\n",
    "    try:\n",
    "        page = requests.get(url, headers=HEADERS, timeout=15)\n",
    "        soup = BeautifulSoup(page.text, \"html.parser\")\n",
    "    except Exception:\n",
    "        # Dead site, timeout, SSL error — treat as \"no links\" and move on\n",
    "        return []\n",
    "\n",
    "    base_domain = urlparse(url).netloc   # e.g. 'www.actlawrence.org'\n",
    "    links = []\n",
    "    seen = set()                          # dedupe: same URL often appears in nav + footer\n",
    "\n",
    "    for a in soup.find_all(\"a\"):\n",
    "        href = a.get(\"href\")\n",
    "        if not href:                      # <a> tags without href (anchors, JS hooks)\n",
    "            continue\n",
    "\n",
    "        # hrefs are often relative ('/about'); urljoin makes them absolute\n",
    "        full_url = urljoin(url, href)\n",
    "\n",
    "        # The visible text of the link — often more informative than the URL.\n",
    "        # e.g. label=\"2023 Impact Report\", url=\".../wp-content/uploads/xy12.pdf\"\n",
    "        label = a.get_text(\" \", strip=True)\n",
    "\n",
    "        same_site = urlparse(full_url).netloc == base_domain\n",
    "        is_pdf = full_url.lower().endswith(\".pdf\")\n",
    "\n",
    "        if (same_site or is_pdf) and full_url not in seen:\n",
    "            seen.add(full_url)\n",
    "            links.append({\"url\": full_url, \"label\": label})\n",
    "    return links\n",
    "\n",
    "\n",
    "# ---------- TIER 3: go one level deeper via About/Publications pages ----------\n",
    "def get_deeper_links(url):\n",
    "    \"\"\"Find About-ish pages on the homepage, then gather THEIR links too.\n",
    "\n",
    "    Used when the homepage alone didn't surface a plan or report — the report\n",
    "    is often one click deeper, e.g. Home -> About -> Annual Reports.\n",
    "    \"\"\"\n",
    "    homepage_links = get_all_links(url)\n",
    "\n",
    "    # Which homepage links look like pages worth digging into?\n",
    "    pages_to_dig = []\n",
    "    for link in homepage_links:\n",
    "        # Search URL and label together — either might contain the giveaway word\n",
    "        haystack = (link[\"url\"] + \" \" + link[\"label\"]).lower()\n",
    "        if any(w in haystack for w in ABOUT_WORDS):\n",
    "            pages_to_dig.append(link[\"url\"])\n",
    "\n",
    "    # Cap at 4: each one is another HTTP request, so this bounds the time cost\n",
    "    pages_to_dig = pages_to_dig[:4]\n",
    "\n",
    "    # Gather the links found ON those deeper pages\n",
    "    deeper_links = []\n",
    "    seen = set()\n",
    "    for page_url in pages_to_dig:\n",
    "        try:\n",
    "            sub_links = get_all_links(page_url)\n",
    "            for L in sub_links:\n",
    "                if L[\"url\"] not in seen:   # dedupe across all 4 pages\n",
    "                    seen.add(L[\"url\"])\n",
    "                    deeper_links.append(L)\n",
    "        except Exception:\n",
    "            continue                        # one bad subpage shouldn't kill the rest\n",
    "\n",
    "    return deeper_links"
   ]
  },
