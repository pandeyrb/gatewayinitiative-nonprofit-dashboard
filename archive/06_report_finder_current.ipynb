    "# Narrow a link list down to ones whose URL or label hints at a report.\n",
    "# This is the cheap pre-filter. Running it before calling Gemini means the\n",
    "# model gets a short, high-signal list instead of 200 nav links.\n",
    "\n",
    "def keyword_filter(all_links):\n",
    "    matched = []\n",
    "    for link in all_links:\n",
    "        haystack = (link[\"url\"] + \" \" + link[\"label\"]).lower()\n",
    "        if any(kw in haystack for kw in KEYWORDS):\n",
    "            matched.append(link)\n",
    "    return matched"
   ]
  },
  {
   "cell_type": "code",
