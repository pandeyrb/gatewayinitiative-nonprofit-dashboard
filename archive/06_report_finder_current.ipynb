    "def download_and_save(url, save_path_no_ext):\n",
    "    try:\n",
    "        r = requests.get(url, headers=HEADERS, timeout=20)\n",
    "        if r.status_code != 200:\n",
    "            return \"\"\n",
    "        if url.lower().endswith(\".pdf\"):\n",
    "            path = save_path_no_ext + \".pdf\"\n",
    "            with open(path, \"wb\") as f:\n",
    "                f.write(r.content)\n",
    "        else:\n",
    "            path = save_path_no_ext + \".html\"\n",
    "            with open(path, \"w\", encoding=\"utf-8\") as f:\n",
    "                f.write(r.text)\n",
    "        return path\n",
    "    except Exception:\n",
    "        return \"\""
   ]
  },
